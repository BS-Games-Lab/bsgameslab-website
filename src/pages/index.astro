---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import logoMark from '../assets/logo-mark.png';
import mahaCrushLogo from '../assets/games/maha-crush-logo.png';
import mahaCrush1 from '../assets/games/maha-crush-1.png';
import mahaCrush3 from '../assets/games/maha-crush-3.png';
import mahaCrush4 from '../assets/games/maha-crush-4.png';

const titleWords = ['BS', 'Games', 'Lab'];
let charIndex = 0;
const title = titleWords.map((word) => [...word].map((char) => ({ char, i: charIndex++ })));

const mahaCrush = {
  no: '01',
  title: 'Maha Crush',
  subtitle: 'Krishna Puzzle',
  url: 'https://play.google.com/store/apps/details?id=com.bsgameslab.mahacrush',
  stats: [
    { label: 'Downloads', value: '10K+' },
    { label: 'Levels', value: '150' },
    { label: 'Languages', value: 'EN · HI · KN' },
  ],
  shots: [
    { src: mahaCrush1, alt: 'Maha Crush gameplay: matching hibiscus, marigold and jasmine flowers to break barricades' },
    { src: mahaCrush3, alt: 'Maha Crush chapter map with watercolour paintings from the Mahabharata' },
    { src: mahaCrush4, alt: 'Maha Crush gameplay: the Gadha booster blasting a piece on the board' },
  ],
};

const upcoming = { no: '02', title: 'Maha Kumbh Mela Game 3D', genre: 'Classified' };

const marquee = Array.from({ length: 6 });
const year = new Date().getFullYear();
---

<Base>
  <header class="topbar container">
    <a class="brand" href="/" aria-label="BS Games Lab — home">
      <Image src={logoMark} alt="" width={40} densities={[1, 2]} loading="eager" />
      <span class="eyebrow">BS Games Lab</span>
    </a>
    <p class="status eyebrow">
      <span class="pulse" aria-hidden="true"></span>
      <span>Now on Google Play</span>
    </p>
  </header>

  <main>
    <section class="hero">
      <div class="hero__inner container">
        <div class="hero__logo">
          <Image
            src={logoMark}
            alt="BS Games Lab logo"
            widths={[240, 360, 480, 640, 747]}
            sizes="(min-width: 64rem) 340px, (min-width: 40rem) 32vw, 48vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <p class="eyebrow hero__eyebrow">Independent Game Studio</p>

        <h1 class="hero__title">
          <span class="sr-only">BS Games Lab</span>
          <span class="hero__words" aria-hidden="true">
            {
              title.map((word) => (
                <span class="word">
                  {word.map(({ char, i }) => (
                    <span class="char" style={`--i:${i}`}>
                      {char}
                    </span>
                  ))}
                </span>
              ))
            }
          </span>
        </h1>

        <p class="hero__tagline">
          <span><a class="hero__game" href={mahaCrush.url}>Maha Crush</a> out now on Google Play</span>
          <span class="hero__dash" aria-hidden="true"></span>
          <span class="shimmer">1 more coming soon</span>
        </p>
      </div>

      <a class="scroll-cue eyebrow" href="#games">
        <span>Scroll</span>
        <span class="scroll-cue__line" aria-hidden="true"></span>
      </a>
    </section>

    <section id="games" class="lab" aria-labelledby="lab-title">
      <div class="container">
        <div class="lab__head">
          <h2 id="lab-title" class="lab__title" data-reveal>
            One out now.<br /><span>One on the way.</span>
          </h2>
        </div>

        <ul class="games" role="list">
          <li data-reveal style="--d:1">
            <article class="card featured" aria-labelledby="maha-crush-title">
              <div class="featured__info">
                <div class="card__top">
                  <span class="eyebrow">No. {mahaCrush.no}</span>
                  <span class="card__tag card__tag--live eyebrow">
                    <span class="pulse" aria-hidden="true"></span>
                    Out now
                  </span>
                </div>

                <div class="featured__head">
                  <Image
                    class="featured__icon"
                    src={mahaCrushLogo}
                    alt=""
                    width={112}
                    densities={[1, 2]}
                  />
                  <h3 id="maha-crush-title" class="featured__title">
                    {mahaCrush.title}
                    <span>{mahaCrush.subtitle}</span>
                  </h3>
                </div>

                <p class="featured__bio">
                  Krishna narrates the Mahabharat as you play. A match 3 puzzle where every level is a new
                  challenge and every chapter brings you closer to India's greatest epic.
                </p>

                <dl class="card__meta featured__stats">
                  {
                    mahaCrush.stats.map((stat) => (
                      <div>
                        <dt class="eyebrow">{stat.label}</dt>
                        <dd>{stat.value}</dd>
                      </div>
                    ))
                  }
                </dl>

                <div class="stores">
                  <a class="store store--live" href={mahaCrush.url} target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="#00a0ff" d="M4 2 4 22 12 12z" />
                      <path fill="#00d26a" d="M4 2 15.2 9 12 12z" />
                      <path fill="#ff3a44" d="M4 22 15.2 15 12 12z" />
                      <path fill="#ffc400" d="M15.2 9 20 12 15.2 15 12 12z" />
                    </svg>
                    <span>
                      <span class="store__small">Get it on</span>
                      Google Play
                    </span>
                  </a>
                  <span class="store store--soon" aria-label="App Store, coming soon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
                      />
                    </svg>
                    <span>
                      <span class="store__small">Coming soon</span>
                      App Store
                    </span>
                  </span>
                </div>
              </div>

              <div class="featured__shots">
                {
                  mahaCrush.shots.map((shot) => (
                    <figure class="phone">
                      <div class="phone__screen">
                        <span class="phone__island" aria-hidden="true" />
                        <Image
                          src={shot.src}
                          alt={shot.alt}
                          widths={[240, 360, 480]}
                          sizes="(min-width: 64rem) 13rem, 28vw"
                        />
                      </div>
                    </figure>
                  ))
                }
              </div>
            </article>
          </li>

          <li data-reveal style="--d:2">
            <article class="card card--wide" data-tilt aria-label={`Mobile game ${upcoming.no}, coming soon`}>
              <div class="card__shine" aria-hidden="true" />
              <div class="card__top">
                <span class="eyebrow">No. {upcoming.no}</span>
                <span class="card__tag eyebrow">Mobile</span>
              </div>

              <p class="card__num" aria-hidden="true">
                {upcoming.no}
              </p>

              <div class="card__bottom">
                <h3 class="card__title">{upcoming.title}</h3>
                <dl class="card__meta">
                  <div>
                    <dt class="eyebrow">Genre</dt>
                    <dd>{upcoming.genre}</dd>
                  </div>
                  <div>
                    <dt class="eyebrow">Status</dt>
                    <dd class="card__status">
                      <span class="pulse" aria-hidden="true" />
                      Coming soon
                    </dd>
                  </div>
                </dl>
              </div>
            </article>
          </li>
        </ul>
      </div>

      <div class="marquee" aria-hidden="true">
        <div class="marquee__track">
          {
            [0, 1].map(() => (
              <div class="marquee__group">
                {marquee.map((_, i) => (
                  <span class:list={['marquee__item', { 'is-outline': i % 2 === 1 }]}>
                    {i % 2 === 0 ? 'Maha Crush out now' : 'Coming soon'} <span class="marquee__star">✦</span>
                  </span>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="footer container">
    <div class="footer__brand">
      <Image src={logoMark} alt="" width={48} densities={[1, 2]} />
      <span class="eyebrow">BS Games Lab</span>
    </div>
    <nav class="footer__legal" aria-label="Policies">
      <p>
        <span class="eyebrow">Maha Crush</span>
        <a href="/maha-crush/privacy">Privacy Policy</a>
        <a href="/maha-crush/delete-data">Delete my data</a>
      </p>
      <p>
        <span class="eyebrow">Maha Kumbh Mela 3D</span>
        <a href="/maha-kumbh/privacy">Privacy Policy</a>
        <a href="/maha-kumbh/delete-data">Delete my data</a>
      </p>
    </nav>
    <p class="footer__copy eyebrow">© {year} BS Games Lab. All rights reserved.</p>
  </footer>
</Base>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  // Reveal sections as they scroll into view
  const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -5% 0px' },
    );
    revealables.forEach((el) => observer.observe(el));
  } else {
    revealables.forEach((el) => el.classList.add('is-in'));
  }

  if (finePointer && !reduceMotion) {
    // Soft spotlight that follows the cursor
    const root = document.documentElement;
    let frame = 0;
    window.addEventListener(
      'pointermove',
      (e) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          root.style.setProperty('--mx', `${e.clientX}px`);
          root.style.setProperty('--my', `${e.clientY}px`);
        });
      },
      { passive: true },
    );

    // Gentle 3D tilt on the game cards
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;
        card.style.setProperty('--rx', `${(0.5 - y) * 8}deg`);
        card.style.setProperty('--ry', `${(x - 0.5) * 10}deg`);
        card.style.setProperty('--px', `${x * 100}%`);
        card.style.setProperty('--py', `${y * 100}%`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--rx');
        card.style.removeProperty('--ry');
      });
    });
  }
</script>

<style>
  /* ---------------- Top bar ---------------- */
  .topbar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: max(clamp(1rem, 3vw, 2rem), env(safe-area-inset-top));
    animation: fade-down 1s var(--ease-out) 1.4s both;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand img {
    width: 2.25rem;
    height: auto;
    transition: transform 0.5s var(--ease-out);
  }

  .brand:hover img {
    transform: rotate(-8deg) scale(1.08);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--cream-line);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* ---------------- Hero ---------------- */
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: 6.5rem 7.5rem;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__logo {
    position: relative;
    width: clamp(10rem, 32vw, 21.25rem);
    margin-bottom: clamp(1.5rem, 4vw, 2.75rem);
    animation: logo-in 1.4s var(--ease-out) both;
  }

  .hero__logo::before {
    content: '';
    position: absolute;
    inset: -25%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(255 236 200 / 0.28), transparent);
    filter: blur(10px);
    animation: glow 6s var(--ease-in-out) 1.4s infinite alternate;
  }

  .hero__logo img {
    width: 100%;
    animation: float 6s var(--ease-in-out) 1.4s infinite alternate;
    filter: drop-shadow(0 1.5rem 2.5rem rgb(90 0 0 / 0.35));
  }

  .hero__eyebrow {
    margin: 0 0 1rem;
    color: var(--cream-dim);
    animation: fade-up 1s var(--ease-out) 0.5s both;
  }

  .hero__title {
    margin: 0;
    font-size: clamp(3rem, 12.5vw, 9.5rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .hero__words {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.24em;
  }

  .word {
    display: inline-flex;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .char {
    display: inline-block;
    animation: char-in 1.1s var(--ease-out) both;
    animation-delay: calc(0.55s + var(--i) * 45ms);
  }

  .hero__tagline {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35em 0.75em;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    font-size: clamp(1.0625rem, 0.9rem + 0.8vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    animation: fade-up 1s var(--ease-out) 1.1s both;
  }

  .hero__game {
    font-weight: 700;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .hero__dash {
    width: 2.5em;
    height: 1px;
    background: var(--cream-dim);
  }

  .shimmer {
    background: linear-gradient(
      100deg,
      var(--cream) 0%,
      var(--cream) 40%,
      #fff 50%,
      var(--cream) 60%,
      var(--cream) 100%
    );
    background-size: 250% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    font-style: italic;
    animation: shimmer 3.5s linear 2s infinite;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--cream-dim);
    text-decoration: none;
    translate: -50% 0;
    animation: fade-up 1s var(--ease-out) 1.6s both;
    transition: color 0.3s;
  }

  .scroll-cue:hover {
    color: var(--cream);
  }

  .scroll-cue__line {
    position: relative;
    width: 1px;
    height: 2.75rem;
    overflow: hidden;
    background: var(--cream-line);
  }

  .scroll-cue__line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--cream);
    animation: scroll-line 2.2s var(--ease-in-out) infinite;
  }

  /* ---------------- Games ---------------- */
  .lab {
    position: relative;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--cream);
    color: var(--red-lo);
    overflow: hidden;
  }

  .lab__head {
    margin-bottom: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .lab__title {
    margin: 0;
    font-size: clamp(2.25rem, 1.2rem + 5vw, 5.5rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .lab__title span {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--red);
  }

  .games {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .games li {
    perspective: 1200px;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    overflow: hidden;
    border-radius: var(--radius);
    background:
      radial-gradient(90% 70% at 50% 0%, rgb(255 255 255 / 0.1), transparent 70%),
      linear-gradient(180deg, var(--red-hi), var(--red-lo));
    color: var(--cream);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      0 2rem 4rem -2rem rgb(140 0 0 / 0.55);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.6s var(--ease-out),
      box-shadow 0.6s var(--ease-out);
    will-change: transform;
  }

  .card:hover {
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      0 2.5rem 5rem -2rem rgb(140 0 0 / 0.7);
  }

  .card__shine {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(28rem circle at var(--px, 50%) var(--py, 0%), rgb(255 255 255 / 0.16), transparent 45%);
    opacity: 0;
    transition: opacity 0.5s;
  }

  .card:hover .card__shine {
    opacity: 1;
  }

  .card__top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card__tag {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--cream-line);
    border-radius: 999px;
  }

  .card__num {
    position: relative;
    margin: 0;
    font-size: clamp(7rem, 18vw, 13rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(248 243 216 / 0.55);
    transition:
      color 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
  }

  .card:hover .card__num {
    color: var(--cream);
    transform: translateX(0.5rem);
  }

  .card__bottom {
    position: relative;
    display: grid;
    gap: 1.25rem;
  }

  .card__title {
    margin: 0;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .card--wide .card__num {
    position: absolute;
    right: clamp(1.25rem, 3vw, 2rem);
    bottom: clamp(1.25rem, 3vw, 2rem);
    font-size: clamp(5rem, 10vw, 8.5rem);
  }

  .card--wide .card__meta {
    max-width: 28rem;
  }

  .card__tag--live {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--cream);
    color: var(--red-lo);
    border-color: var(--cream);
  }

  /* ---------------- Featured game ---------------- */
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .featured__info {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .featured__head {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .featured__icon {
    flex: none;
    width: clamp(4.5rem, 9vw, 7rem);
    border-radius: 22%;
    box-shadow:
      0 0 0 2px rgb(248 243 216 / 0.35),
      0 1rem 2rem -0.75rem rgb(90 0 0 / 0.6);
  }

  .featured__title {
    display: grid;
    margin: 0;
    font-size: clamp(2rem, 1.2rem + 3vw, 3.75rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .featured__title span {
    margin-top: 0.4rem;
    font-size: 0.42em;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--cream-dim);
  }

  .featured__bio {
    max-width: 34rem;
    margin: 0;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
  }

  .featured .featured__stats {
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    column-gap: clamp(1.5rem, 4vw, 3rem);
  }

  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .store {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.75rem 0.95rem 1.3rem;
    border: 1.5px solid var(--cream-line);
    border-radius: 999px;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.05;
    text-decoration: none;
    white-space: nowrap;
  }

  .store svg {
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
  }

  .store > span {
    display: grid;
  }

  .store--live {
    border-color: var(--cream);
    background: var(--cream);
    color: var(--red-lo);
    box-shadow: 0 1rem 2rem -1rem rgb(90 0 0 / 0.7);
    animation: store-glow 2.8s var(--ease-in-out) infinite;
    transition: transform 0.4s var(--ease-out);
  }

  .store--live:hover {
    transform: translateY(-2px) scale(1.02);
  }

  .store--soon {
    background: rgb(0 0 0 / 0.08);
    color: var(--cream-dim);
    cursor: default;
  }

  .store__small {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .featured__shots {
    display: flex;
