---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import logoMark from '../assets/logo-mark.png';

const titleWords = ['BS', 'Games', 'Lab'];
let charIndex = 0;
const title = titleWords.map((word) => [...word].map((char) => ({ char, i: charIndex++ })));

const games = [
  { no: '01', genre: 'Classified' },
  { no: '02', genre: 'Classified' },
];

const marquee = Array.from({ length: 6 });
const year = new Date().getFullYear();
---

<Base>
  <header class="topbar container">
    <a class="brand" href="/" aria-label="BS Games Lab — home">
      <Image src={logoMark} alt="" width={40} densities={[1, 2]} loading="eager" />
      <span class="eyebrow">BS Games Lab</span>
    </a>
    <p class="status eyebrow">
      <span class="pulse" aria-hidden="true"></span>
      <span>In development</span>
    </p>
  </header>

  <main>
    <section class="hero">
      <div class="hero__inner container">
        <div class="hero__logo">
          <Image
            src={logoMark}
            alt="BS Games Lab logo"
            widths={[240, 360, 480, 640, 747]}
            sizes="(min-width: 64rem) 340px, (min-width: 40rem) 32vw, 48vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <p class="eyebrow hero__eyebrow">Independent Game Studio</p>

        <h1 class="hero__title">
          <span class="sr-only">BS Games Lab</span>
          <span class="hero__words" aria-hidden="true">
            {
              title.map((word) => (
                <span class="word">
                  {word.map(({ char, i }) => (
                    <span class="char" style={`--i:${i}`}>
                      {char}
                    </span>
                  ))}
                </span>
              ))
            }
          </span>
        </h1>

        <p class="hero__tagline">
          <span class="hero__count">2</span> mobile games
          <span class="hero__dash" aria-hidden="true"></span>
          <span class="shimmer">coming soon</span>
        </p>
      </div>

      <a class="scroll-cue eyebrow" href="#games">
        <span>Scroll</span>
        <span class="scroll-cue__line" aria-hidden="true"></span>
      </a>
    </section>

    <section id="games" class="lab" aria-labelledby="lab-title">
      <div class="container">
        <div class="lab__head">
          <p class="eyebrow lab__eyebrow" data-reveal>In the lab · 02 projects</p>
          <h2 id="lab-title" class="lab__title" data-reveal style="--d:1">
            Two mobile games.<br /><span>Coming soon.</span>
          </h2>
        </div>

        <ul class="games" role="list">
          {
            games.map((game, i) => (
              <li data-reveal style={`--d:${i + 1}`}>
                <article class="card" data-tilt aria-label={`Mobile game ${game.no}, coming soon`}>
                  <div class="card__shine" aria-hidden="true" />
                  <div class="card__top">
                    <span class="eyebrow">No. {game.no}</span>
                    <span class="card__tag eyebrow">Mobile</span>
                  </div>

                  <p class="card__num" aria-hidden="true">
                    {game.no}
                  </p>

                  <div class="card__bottom">
                    <h3 class="card__title">
                      <span class="sr-only">Title to be revealed</span>
                      <span class="redact" aria-hidden="true" />
                    </h3>
                    <dl class="card__meta">
                      <div>
                        <dt class="eyebrow">Genre</dt>
                        <dd>{game.genre}</dd>
                      </div>
                      <div>
                        <dt class="eyebrow">Status</dt>
                        <dd class="card__status">
                          <span class="pulse" aria-hidden="true" />
                          Coming soon
                        </dd>
                      </div>
                    </dl>
                  </div>
                </article>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="marquee" aria-hidden="true">
        <div class="marquee__track">
          {
            [0, 1].map(() => (
              <div class="marquee__group">
                {marquee.map((_, i) => (
                  <span class:list={['marquee__item', { 'is-outline': i % 2 === 1 }]}>
                    Coming soon <span class="marquee__star">✦</span>
                  </span>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="footer container">
    <div class="footer__brand">
      <Image src={logoMark} alt="" width={48} densities={[1, 2]} />
      <span class="eyebrow">BS Games Lab</span>
    </div>
    <p class="footer__copy eyebrow">© {year} BS Games Lab. All rights reserved.</p>
  </footer>
</Base>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  // Reveal sections as they scroll into view
  const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -5% 0px' },
    );
    revealables.forEach((el) => observer.observe(el));
  } else {
    revealables.forEach((el) => el.classList.add('is-in'));
  }

  if (finePointer && !reduceMotion) {
    // Soft spotlight that follows the cursor
    const root = document.documentElement;
    let frame = 0;
    window.addEventListener(
      'pointermove',
      (e) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          root.style.setProperty('--mx', `${e.clientX}px`);
          root.style.setProperty('--my', `${e.clientY}px`);
        });
      },
      { passive: true },
    );

    // Gentle 3D tilt on the game cards
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;
        card.style.setProperty('--rx', `${(0.5 - y) * 8}deg`);
        card.style.setProperty('--ry', `${(x - 0.5) * 10}deg`);
        card.style.setProperty('--px', `${x * 100}%`);
        card.style.setProperty('--py', `${y * 100}%`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--rx');
        card.style.removeProperty('--ry');
      });
    });
  }
</script>

<style>
  /* ---------------- Top bar ---------------- */
  .topbar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: max(clamp(1rem, 3vw, 2rem), env(safe-area-inset-top));
    animation: fade-down 1s var(--ease-out) 1.4s both;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand img {
    width: 2.25rem;
    height: auto;
    transition: transform 0.5s var(--ease-out);
  }

  .brand:hover img {
    transform: rotate(-8deg) scale(1.08);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--cream-line);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* ---------------- Hero ---------------- */
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: 6.5rem 5.5rem;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__logo {
    position: relative;
    width: clamp(10rem, 32vw, 21.25rem);
    margin-bottom: clamp(1.5rem, 4vw, 2.75rem);
    animation: logo-in 1.4s var(--ease-out) both;
  }

  .hero__logo::before {
    content: '';
    position: absolute;
    inset: -25%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(255 236 200 / 0.28), transparent);
    filter: blur(10px);
    animation: glow 6s var(--ease-in-out) 1.4s infinite alternate;
  }

  .hero__logo img {
    width: 100%;
    animation: float 6s var(--ease-in-out) 1.4s infinite alternate;
    filter: drop-shadow(0 1.5rem 2.5rem rgb(90 0 0 / 0.35));
  }

  .hero__eyebrow {
    margin: 0 0 1rem;
    color: var(--cream-dim);
    animation: fade-up 1s var(--ease-out) 0.5s both;
  }

  .hero__title {
    margin: 0;
    font-size: clamp(3rem, 12.5vw, 9.5rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .hero__words {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.24em;
  }

  .word {
    display: inline-flex;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .char {
    display: inline-block;
    animation: char-in 1.1s var(--ease-out) both;
    animation-delay: calc(0.55s + var(--i) * 45ms);
  }

  .hero__tagline {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35em 0.75em;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    font-size: clamp(1.0625rem, 0.9rem + 0.8vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    animation: fade-up 1s var(--ease-out) 1.1s both;
  }

  .hero__count {
    display: inline-grid;
    place-items: center;
    width: 1.9em;
    height: 1.9em;
    margin-right: -0.35em;
    border-radius: 50%;
    background: var(--cream);
    color: var(--red-lo);
    font-weight: 700;
  }

  .hero__dash {
    width: 2.5em;
    height: 1px;
    background: var(--cream-dim);
  }

  .shimmer {
    background: linear-gradient(
      100deg,
      var(--cream) 0%,
      var(--cream) 40%,
      #fff 50%,
      var(--cream) 60%,
      var(--cream) 100%
    );
    background-size: 250% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    font-style: italic;
    animation: shimmer 3.5s linear 2s infinite;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--cream-dim);
    text-decoration: none;
    translate: -50% 0;
    animation: fade-up 1s var(--ease-out) 1.6s both;
    transition: color 0.3s;
  }

  .scroll-cue:hover {
    color: var(--cream);
  }

  .scroll-cue__line {
    position: relative;
    width: 1px;
    height: 2.75rem;
    overflow: hidden;
    background: var(--cream-line);
  }

  .scroll-cue__line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--cream);
    animation: scroll-line 2.2s var(--ease-in-out) infinite;
  }

  /* ---------------- Games ---------------- */
  .lab {
    position: relative;
    padding-top: clamp(4.5rem, 10vw, 8rem);
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--cream);
    color: var(--red-lo);
    overflow: hidden;
  }

  .lab__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .lab__eyebrow {
    margin: 0;
    color: var(--red);
  }

  .lab__title {
    margin: 0;
    font-size: clamp(2.25rem, 1.2rem + 5vw, 5.5rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .lab__title span {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--red);
  }

  .games {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .games li {
    perspective: 1200px;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    aspect-ratio: 4 / 4.4;
    min-height: 22rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    overflow: hidden;
    border-radius: var(--radius);
    background:
      radial-gradient(90% 70% at 50% 0%, rgb(255 255 255 / 0.1), transparent 70%),
      linear-gradient(180deg, var(--red-hi), var(--red-lo));
    color: var(--cream);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      0 2rem 4rem -2rem rgb(140 0 0 / 0.55);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.6s var(--ease-out),
      box-shadow 0.6s var(--ease-out);
    will-change: transform;
  }

  .card:hover {
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      0 2.5rem 5rem -2rem rgb(140 0 0 / 0.7);
  }

  .card__shine {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(28rem circle at var(--px, 50%) var(--py, 0%), rgb(255 255 255 / 0.16), transparent 45%);
    opacity: 0;
    transition: opacity 0.5s;
  }

  .card:hover .card__shine {
    opacity: 1;
  }

  .card__top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card__tag {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--cream-line);
    border-radius: 999px;
  }

  .card__num {
    position: relative;
    margin: 0;
    font-size: clamp(7rem, 18vw, 13rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(248 243 216 / 0.55);
    transition:
      color 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
  }

  .card:hover .card__num {
    color: var(--cream);
    transform: translateX(0.5rem);
  }

  .card__bottom {
    position: relative;
    display: grid;
    gap: 1.25rem;
  }

  .card__title {
    margin: 0;
  }

  .redact {
    display: block;
    width: 70%;
    height: clamp(1.5rem, 3vw, 2rem);
    border-radius: 0.375rem;
    background: linear-gradient(
      90deg,
      rgb(248 243 216 / 0.22) 0%,
      rgb(248 243 216 / 0.5) 50%,
      rgb(248 243 216 / 0.22) 100%
    );
    background-size: 200% 100%;
    animation: skeleton 2.4s linear infinite;
  }

  .card__meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--cream-line);
  }

  .card__meta dt {
    margin-bottom: 0.35rem;
    color: var(--cream-dim);
  }

  .card__meta dd {
    margin: 0;
    font-weight: 600;
  }

  .card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* ---------------- Marquee ---------------- */
  .marquee {
    margin-top: clamp(4rem, 9vw, 7rem);
    padding-block: clamp(1rem, 2.5vw, 1.75rem);
    overflow: hidden;
    border-block: 1px solid rgb(214 0 0 / 0.18);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 32s linear infinite;
  }

  .marquee__group {
    display: flex;
    flex: none;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding-right: 0.5em;
    font-size: clamp(2rem, 1rem + 5vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .marquee__item.is-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--red);
  }

  .marquee__star {
    font-size: 0.5em;
    color: var(--red);
    -webkit-text-stroke: 0;
  }

  /* ---------------- Footer ---------------- */
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: clamp(2rem, 4vw, 3rem) max(clamp(2rem, 4vw, 3rem), env(safe-area-inset-bottom));
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer__brand img {
    width: 2.5rem;
  }

  .footer__copy {
    margin: 0;
    color: var(--cream-dim);
    letter-spacing: 0.12em;
  }

  /* ---------------- Responsive tweaks ---------------- */
  @media (max-width: 22.5rem) {
    .status,
    .hero__dash {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .card {
      aspect-ratio: auto;
      min-height: 24rem;
    }
  }

  @media (max-height: 34rem) and (orientation: landscape) {
    .hero__logo {
      width: clamp(6rem, 22vh, 9rem);
      margin-bottom: 1rem;
    }

    .hero__title {
      font-size: clamp(2.5rem, 14vh, 5rem);
    }

    .scroll-cue {
      display: none;
    }
  }

  /* ---------------- Keyframes ---------------- */
  @keyframes logo-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem) scale(0.9);
      filter: blur(12px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  @keyframes float {
    from { transform: translateY(0); }
    to { transform: translateY(-0.75rem); }
  }

  @keyframes glow {
    from { opacity: 0.6; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1.05); }
  }

  @keyframes char-in {
    from { transform: translateY(110%) rotate(6deg); }
    to { transform: none; }
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: none; }
  }

  @keyframes fade-down {
    from { opacity: 0; transform: translateY(-1rem); }
    to { opacity: 1; transform: none; }
  }

  @keyframes shimmer {
    from { background-position: 100% 0; }
    to { background-position: -150% 0; }
  }

  @keyframes skeleton {
    from { background-position: 100% 0; }
    to { background-position: -100% 0; }
  }

  @keyframes scroll-line {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  @keyframes marquee {
    to { transform: translateX(-50%); }
  }
</style>
