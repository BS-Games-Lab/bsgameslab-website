---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import logoMark from '../assets/logo-mark.png';

interface Props {
  frontmatter: {
    title: string;
    game: string;
    description: string;
    updated?: string;
  };
}

const { title, game, description, updated } = Astro.props.frontmatter;
---

<Base title={`${title} — ${game} — BS Games Lab`} description={description}>
  <header class="topbar container">
    <a class="brand" href="/" aria-label="BS Games Lab — home">
      <Image src={logoMark} alt="" width={40} densities={[1, 2]} loading="eager" />
      <span class="eyebrow">BS Games Lab</span>
    </a>
  </header>

  <main class="legal">
    <div class="legal__inner">
      <p class="eyebrow legal__game">{game}</p>
      <h1 class="legal__title">{title}</h1>
      <dl class="legal__meta">
        <div>
          <dt class="eyebrow">Developer</dt>
          <dd>B S Games Lab</dd>
        </div>
        <div>
          <dt class="eyebrow">Contact</dt>
          <dd><a href="mailto:bsgameslab@gmail.com">bsgameslab@gmail.com</a></dd>
        </div>
        {
          updated && (
            <div>
              <dt class="eyebrow">Last updated</dt>
              <dd>{updated}</dd>
            </div>
          )
        }
      </dl>

      <div class="prose">
        <slot />
      </div>
    </div>
  </main>

  <footer class="footer container">
    <a class="eyebrow" href="/">← Back to BS Games Lab</a>
  </footer>
</Base>

<style>
  .topbar {
    padding-block: max(clamp(1rem, 3vw, 2rem), env(safe-area-inset-top)) clamp(1.5rem, 4vw, 2.5rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand img {
    width: 2.25rem;
    height: auto;
  }

  .legal {
    border-radius: var(--radius);
    margin-inline: auto;
    max-width: calc(var(--max) - 2 * var(--gutter));
    width: calc(100% - 2 * var(--gutter));
    background: var(--cream);
    color: var(--ink);
  }

  .legal__inner {
    max-width: 46rem;
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 4.5rem) clamp(1.25rem, 5vw, 3rem);
  }

  .legal__game {
    margin: 0 0 0.75rem;
    color: var(--red);
  }

  .legal__title {
    margin: 0;
    color: var(--red-lo);
    font-size: clamp(2.25rem, 1.4rem + 4vw, 4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .legal__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(1.5rem, 4vw, 3rem);
    margin: clamp(1.5rem, 4vw, 2.25rem) 0 0;
    padding-block: 1.25rem;
    border-block: 1px solid rgb(214 0 0 / 0.18);
  }

  .legal__meta dt {
    margin-bottom: 0.3rem;
    color: var(--red);
  }

  .legal__meta dd {
    margin: 0;
    font-weight: 600;
  }

  .prose {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .prose :global(h2) {
    margin: 2.25em 0 0.6em;
    color: var(--red-lo);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 1em;
  }

  .prose :global(ul) {
    padding-left: 1.25em;
  }

  .prose :global(li) {
    margin-bottom: 0.4em;
  }

  .prose :global(li::marker) {
    color: var(--red);
  }

  .prose :global(a) {
    color: var(--red-lo);
    text-underline-offset: 0.15em;
  }

  .legal__meta a {
    color: inherit;
  }

  .footer {
    padding-block: clamp(2rem, 4vw, 3rem) max(clamp(2rem, 4vw, 3rem), env(safe-area-inset-bottom));
  }

  .footer a {
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
  }
</style>
